# Copy this file to .env and edit values for the customer environment.
# .env is intentionally ignored by version control.

# Nemotron 3 Super NIM and tokenizer
NIM_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
NIM_TOKENIZER_PATH=/path/to/nim_cache/nim/huggingface/hub/downloads/nvidia/nemotron-3-super-120b-a12b-nvfp4
NIM_BASE_URL=http://127.0.0.1:18000
NIM_METRICS_URL=http://127.0.0.1:18000/v1/metrics
NIM_PROMETHEUS_TARGET=host.docker.internal:18000
NIM_API_KEY=

# Kubernetes port-forward helper values
K8S_NAMESPACE=your-namespace
K8S_NIM_SERVICE=your-nim-service
K8S_NIM_DEPLOYMENT=your-nim-deployment
NIM_LOCAL_PORT=18000
# 0.0.0.0 is required for host.docker.internal; restrict access with a host firewall.
NIM_BIND_ADDRESS=0.0.0.0

# Local observability stack
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3001
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Client-side offered load. These do not configure NIM max model length or max sequences.
AIPERF_ISL_VALUES=128,512,1024
AIPERF_OSL_VALUES=32,128,256,512
AIPERF_SWEEP_TYPE=grid
AIPERF_CONCURRENCY=32
AIPERF_REQUEST_COUNT=64
AIPERF_WARMUP_REQUEST_COUNT=16
AIPERF_SMOKE_REQUEST_COUNT=32
AIPERF_SMOKE_WARMUP_REQUEST_COUNT=1
AIPERF_NUM_DATASET_ENTRIES=200
AIPERF_RANDOM_SEED=17
AIPERF_FORCE_EXACT_OSL=true
AIPERF_SWEEP_COOLDOWN_SECONDS=10
AIPERF_NUM_PROFILE_RUNS=1
AIPERF_PROFILE_RUN_COOLDOWN_SECONDS=10
RUN_SMOKE_TEST=true
RUN_FULL_SWEEP=false
